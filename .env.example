# GEMINI_API_KEY: Optional (PDFQuick processes PDFs 100% locally in the browser).
GEMINI_API_KEY=""

# VITE_SITE_URL: Canonical production URL (defaults to https://bdf-mufv.vercel.app).
# Set this only when migrating to a custom domain, e.g. https://yourdomain.com
VITE_SITE_URL=""

# Operator & Trust Disclosures (leave blank until ready to publish verified details)
VITE_OPERATOR_NAME=""
VITE_SUPPORT_EMAIL=""
VITE_PRIVACY_EMAIL=""
VITE_DMCA_EMAIL=""
VITE_OPERATOR_ADDRESS=""
VITE_OPERATOR_JURISDICTION=""
VITE_EFFECTIVE_DATE="November 2026"

# Google AdSense (strictly disabled until owner enables after site & CMP approval)
VITE_ADSENSE_ENABLED="false"
VITE_ADSENSE_PUBLISHER_ID=""

# Google-Certified CMP for EEA/UK/CH visitors ("none" | "funding-choices" | "iab-tcf")
VITE_CMP_PROVIDER="none"
VITE_CMP_SCRIPT_URL=""

